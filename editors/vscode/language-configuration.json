{
  "comments": {
    "lineComment": "//",
    "blockComment": ["/*", "*/"]
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] },
    { "open": "/**", "close": " */", "notIn": ["string"] }
  ],
  "autoCloseBefore": ";:.,=}])> \n\t",
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"],
    ["`", "`"],
    ["<", ">"]
  ],
  "folding": {
    "markers": {
      "start": "^\\s*//\\s*(?:#?region\\b|<editor-fold\\b)",
      "end": "^\\s*//\\s*(?:#?endregion\\b|</editor-fold>)"
    }
  },
  "indentationRules": {
    "increaseIndentPattern": "^.*(\\{[^}\"'`]*|\\([^)\"'`]*|\\[[^\\]\"'`]*|->\\s*)$",
    "decreaseIndentPattern": "^\\s*[}\\])]"
  },
  "wordPattern": "`[^`]+`|[A-Za-z_][A-Za-z0-9_]*|-?\\d+(?:\\.\\d+)?",
  "onEnterRules": [
    {
      "beforeText": "^\\s*/\\*\\*(?!/)([^*]|\\*(?!/))*$",
      "afterText": "^\\s*\\*/$",
      "action": { "indent": "indentOutdent", "appendText": " * " }
    },
    {
      "beforeText": "^\\s*/\\*\\*(?!/)([^*]|\\*(?!/))*$",
      "action": { "indent": "none", "appendText": " * " }
    },
    {
      "beforeText": "^(\\t|  )*\\s\\*(\\s([^*]|\\*(?!/))*)?$",
      "action": { "indent": "none", "appendText": "* " }
    },
    {
      "beforeText": "^(\\t|  )*\\s\\*/\\s*$",
      "action": { "indent": "none", "removeText": 1 }
    }
  ]
}
